#!/usr/bin/env bash

cat << 'EOF' > .gitignore
# Dependências do Node
node_modules/
.pnpm-store/

# Pastas de Build e Saída
dist/
build/
.output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Configurações de IDEs e Editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Variáveis de Ambiente e Arquivos Locais
.env
.env.local
.env.*.local

# Cache do Vite / Ferramentas
.vite/
EOF

setup.sh